  "ExternalDatabaseInfo": {
    "DataBaseType": "6db454c0-531c-4395-9122-921a18942902",
    "ConnectionId": "MySql1",
    "SourceTableName": "ymia_v_pban_shikumi",
    "SourceTableSchema": "",
    "CreateViewSql": "select `t_juchu`.`JUCHU_NBR` AS `受注No`,`t_juchu`.`TORIHIKISAKI_CODE` AS `売上先コード`,`t_juchu`.`CHUMONSHO_NBR` AS `注文番号`,`t_juchu`.`SEIBAN` AS `ヘッダー製番（機械工番）`,`t_juchu`.`TEHAI_KOBAN` AS `手配工番`,`t_juchum`.`HINBAN` AS `仕組部品コード`,`t_juchum`.`SURYO` AS `受注数量`,`t_juchum`.`HANBAI_TANKA` AS `受注単価`,`t_juchum`.`SEIBAN` AS `明細製番`,`t_buhink`.`HINBAN` AS `子部品コード`,`t_buhink`.`SURYO` AS `構成数量`,`t_buhink`.`KOSEI_NAME` AS `子部品名称`,`t_buhink`.`KURADASHI_KOTEI` AS `ロケーション`,`t_buhink`.`KIKAKU` AS `規格・寸法`,`m_hinban`.`HINMEI` AS `品名`,`m_hinban`.`KEISHIKI` AS `仕様詳細`,`m_hinban`.`KAITEI_SEQ_NBR` AS `最新改訂通番`,`m_name`.`MEISHO` AS `単位名称` from ((((`tjuchu` `t_juchu` join `tjuchum` `t_juchum` on((`t_juchu`.`JUCHU_NBR` = `t_juchum`.`JUCHU_NBR`))) join `tbuhink` `t_buhink` on(((`t_juchu`.`TEHAI_KOBAN` = `t_buhink`.`SEIBAN`) and (`t_juchum`.`SEIBAN` = `t_buhink`.`KOBAN`)))) left join `mhinban` `m_hinban` on(((`t_buhink`.`HINBAN` = `m_hinban`.`HINBAN`) and (`m_hinban`.`KAITEI_SEQ_NBR` = (select max(`sub`.`KAITEI_SEQ_NBR`) from `mhinban` `sub` where (`sub`.`HINBAN` = `t_buhink`.`HINBAN`)))))) left join `mname` `m_name` on(((`m_hinban`.`TANI_CODE` = `m_name`.`MEISHO_CODE`) and (`m_name`.`MEISHO_KUBUN` = 48)))) where (`t_juchu`.`TEHAI_KOBAN` like 'P%')",
