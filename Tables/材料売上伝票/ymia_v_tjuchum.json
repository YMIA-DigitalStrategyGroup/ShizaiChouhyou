    "SourceTableSchema": "",
    "CreateViewSql": "select `t_juchu`.`JUCHU_NBR` AS `受注No（工事№）`,`t_juchu`.`CHUMONSHO_NBR` AS `注文番号`,`t_juchu`.`TORIHIKISAKI_CODE` AS `売上先コード`,`t_juchu`.`NONYUSAKI` AS `納入先（送り先）名称`,`t_juchu`.`IRAI_DATE` AS `受注日`,`t_juchu`.`KOJO_SHUKKA_YOTEI_DATE` AS `出荷予定日`,`t_juchu`.`SEIBAN` AS `ヘッダー製番（機械工番）`,`t_juchu`.`TEHAI_KOBAN` AS `手配工番`,`t_juchum`.`HINBAN` AS `品番（部品コード）`,`t_juchum`.`SURYO` AS `数量`,`t_juchum`.`HANBAI_TANKA` AS `販売単価`,`t_juchum`.`HANBAI_KINGAKU` AS `販売金額`,`t_juchum`.`SEIBAN` AS `明細製番`,`m_torihiki`.`ADDRESS` AS `売上先・送り先住所`,`m_torihiki`.`POST_CODE` AS `郵便番号`,`m_hinban`.`HINMEI` AS `部品名称`,`m_hinban`.`KIKAKU` AS `規格・寸法`,`m_hinban`.`TANABAN` AS `ロケーション（棚番）`,`m_name`.`MEISHO` AS `単位名称` from ((((`tjuchu` `t_juchu` join `tjuchum` `t_juchum` on((`t_juchu`.`JUCHU_NBR` = `t_juchum`.`JUCHU_NBR`))) left join `mtorihiki` `m_torihiki` on((`t_juchu`.`TORIHIKISAKI_CODE` = `m_torihiki`.`TORIHIKISAKI_CODE`))) left join `mhinban` `m_hinban` on((`t_juchum`.`HINBAN` = `m_hinban`.`HINBAN`))) left join `mname` `m_name` on(((`m_hinban`.`TANI_CODE` = `m_name`.`MEISHO_CODE`) and (`m_name`.`MEISHO_KUBUN` = 48))))",
    "ViewInfo": {
